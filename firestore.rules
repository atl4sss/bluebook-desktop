rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the creator knows the random UUID. The console/Admin SDK bypasses
    // these rules and may flip approved; clients cannot approve themselves.
    match /enteredCodes/{entryId} {
      allow create: if
        entryId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$') &&
        request.resource.data.keys().hasAll(['name', 'code', 'createdAt', 'approved']) &&
        request.resource.data.keys().hasOnly(['name', 'code', 'createdAt', 'approved']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.code is string &&
        request.resource.data.code.matches('^[0-9]{6}$') &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.approved == false;
      allow get: if entryId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
      allow list, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
