rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The start screen may create a name/code entry without an account.
    // Entries remain private and cannot be changed or deleted by clients.
    match /enteredCodes/{entryId} {
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'code', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.code is string &&
        request.resource.data.code.matches('^[0-9]{6}$') &&
        request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
